# URL to your self-hosted GitLab instance.
# Do NOT include /api/v4 — it is appended automatically.
GITLAB_URL=https://gitlab.example.com

# === Auth — pick one of the two paths below ===

# Path A: Personal Access Token (simplest, long-lived secret).
# Create at: <GITLAB_URL>/-/user_settings/personal_access_tokens
# Scope: api
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Path B: OAuth 2.0 authorization-code + PKCE (browser login, auto-refresh).
# Register an OAuth Application in your GitLab profile or admin area:
#   <GITLAB_URL>/-/user_settings/applications
# with redirect URI exactly matching GITLAB_OAUTH_REDIRECT_PORT below
# (default: http://127.0.0.1:7898/callback). Scope: api.
# Then run `gitlab-mr-mcp login` to do the browser flow once.
# GITLAB_OAUTH_CLIENT_ID=
# GITLAB_OAUTH_CLIENT_SECRET=   # optional, only for confidential apps
# GITLAB_OAUTH_SCOPE=api        # optional, default "api"
# GITLAB_OAUTH_REDIRECT_PORT=7898  # optional, default 7898
